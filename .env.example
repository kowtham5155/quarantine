# ---------------------------------------------------------------------------
# Quarantine — environment contract. Validated by lib/env.ts at boot.
# Copy to .env.local and fill in. Never commit the filled-in file.
#
# TWO FILES, ON PURPOSE — this trips everyone up once:
#
#   .env.local   read by the Next.js runtime (dev server, build, `npm start`).
#                Holds everything below. A Next.js convention.
#   .env         read by the Prisma CLI. Holds DATABASE_URL and DIRECT_URL and
#                nothing else.
#
# The Prisma CLI does not know what .env.local is — it is not a dotenv standard,
# it is a Next.js one — so `npx prisma migrate deploy` with only .env.local
# present fails with "Environment variable not found: DIRECT_URL". Both files
# are gitignored.
#
# Keep the two connection strings identical in both files. If they drift, the
# app and your migrations talk to different databases and the symptom is a
# missing column rather than anything that names the real cause.
#
# The npm scripts (db:migrate, db:deploy, db:seed, db:studio) go through
# `dotenv -e .env.local`, so they work whether or not .env exists. A bare
# `npx prisma ...` needs .env.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (POOLED — hostname contains "-pooler").
# Needed in both .env and .env.local.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/db?sslmode=require"

# Unpooled connection string, used by `prisma migrate` only. Neon serves the
# pooled URL through PgBouncer in transaction mode, which cannot run DDL — a
# migration against it fails on prepared statements. Take DATABASE_URL and
# remove "-pooler" from the hostname.
# Needed in both .env and .env.local.
DIRECT_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Auth.js v5 signing secret.  Generate: openssl rand -base64 32
AUTH_SECRET="generate with: openssl rand -base64 32"

# Canonical origin Auth.js issues callbacks against.
AUTH_URL="http://localhost:3000"

# Public origin used for absolute links in reports, emails and the CLI.
APP_URL="http://localhost:3000"

# Shared secret the scheduler presents to /api/cron/*.  Generate: openssl rand -hex 32
CRON_SECRET="generate with: openssl rand -hex 32"

# Optional. Raises the GitHub API rate limit used by provenance diffing
# (signal family 6). Without it, tag/tarball fetches degrade to
# REPO_UNREACHABLE once the 60 req/h anonymous limit is hit.
# Needs public repository read access only.
GITHUB_TOKEN=""

# Optional, comma-separated. Emails allowed into the cross-tenant /admin
# surface. Platform administration is not a database role on purpose: a role
# could be granted from inside the app, and this surface reads across every
# tenant. Leave it empty and /admin is closed to everyone.
PLATFORM_ADMIN_EMAILS=""

# development | test | production
NODE_ENV="development"

# Optional: trace | debug | info | warn | error | fatal
# LOG_LEVEL="debug"
