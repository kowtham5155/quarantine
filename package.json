{
  "name": "quarantine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "format": "prettier --write .",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset"
  },
  "dependencies": {
    "@node-rs/argon2": "2.1.0",
    "@prisma/client": "6.19.3",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.33.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "otplib": "13.5.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tar": "7.5.22",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
